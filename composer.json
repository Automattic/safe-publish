{
  "name": "automattic/safe-publish",
  "authors": [
    {
      "name": "WPVIP"
    }
  ],
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "Safe_Publish\\": "includes/"
    },
    "classmap": [
      "includes/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Safe_Publish\\Tests\\Integration\\": "tests/integration/",
      "Safe_Publish\\Tests\\": "tests/unit/"
    },
    "classmap": [
      "tests/unit/"
    ]
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcs-fix": "phpcbf",
    "psalm": "psalm.phar --no-cache",
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-clover ./coverage/phpunit/clover.xml"
  },
  "require": {
    "php": ">=8.2",
    "galbar/jsonpath": "^3.0",
    "guzzlehttp/guzzle": "^7.8",
    "kevinrob/guzzle-cache-middleware": "^6.0",
    "erusev/parsedown": "^1.7",
    "symfony/var-exporter": "^6"
  },
  "require-dev": {
    "automattic/vipwpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9",
    "slevomat/coding-standard": "^8.15",
    "php-stubs/wordpress-stubs": "6.8.*",
    "psalm/phar": "^6.5",
    "mockery/mockery": "^1.6",
    "wp-phpunit/wp-phpunit": "^6.8",
    "yoast/phpunit-polyfills": "^4.0",
    "php-stubs/wordpress-globals": "^0.2.0",
    "php-stubs/wordpress-tests-stubs": "6.8.*"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
