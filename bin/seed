#!/bin/sh
#
# Seed the source or destination WordPress site with test content.
#
# This is the intended entry point for the seeder. It routes the command to the
# correct wp-env container and delegates execution to bin/seed-content.php via
# WP-CLI eval-file.
#
# Usage: bin/seed [site=source|destination|both] [mode=create|update] [preset=full] [count=N] [start=N] [type=post|page|slug] [editor=gutenberg|classic|mixed] [images=1|2|2-resized|auto] [fresh=1] [revision=N]
#
# Arguments:
#   site=     Which site to seed: source (default), destination, or both.
#   mode=     create (default) inserts new posts; update bumps existing seeded
#             posts to a new revision. mode=update doesn't support preset= or fresh=.
#   preset=   Run a curated set: full (10 Gutenberg posts, 10 classic posts, 5 pages).
#             When preset is set, all other arguments except site= and fresh= are ignored.
#   count=    Number of posts to create (default: 20).
#   start=    Starting post number (default: 1). Use to avoid duplicate numbers across batches.
#   type=     Post type slug. In create mode, defaults to post. In update mode, omit
#             to update every seeded post type; set to limit the update.
#   editor=   Content format: gutenberg (default), classic, or mixed.
#   images=   Image mode: 1, 2, 2-resized, or auto (default, cycles through all three).
#   fresh=    Set to 1 to delete all previously seeded content before seeding.
#   revision= Target revision number for mode=update. Omit to auto-bump each post's
#             current revision by one.
#
# Examples:
#   bin/seed
#   bin/seed site=destination count=5 type=page
#   bin/seed site=both editor=mixed fresh=1
#   bin/seed preset=full
#   bin/seed preset=full site=both fresh=1
#   bin/seed mode=update
#   bin/seed mode=update site=both revision=2

set -e

# wp-env mounts the plugin under wp-content/plugins/<checkout dir name>,
# which differs from the canonical slug in worktrees.
PLUGIN_DIR="$(basename "$(git rev-parse --show-toplevel)")"

SITE="source"
PRESET=""
FRESH_ARG=""
MODE=""
PHP_ARGS=""

for arg in "$@"; do
	case "$arg" in
		site=*)
			SITE="${arg#site=}"
			;;
		preset=*)
			PRESET="${arg#preset=}"
			;;
		fresh=*)
			FRESH_ARG="$arg"
			;;
		mode=*)
			MODE="${arg#mode=}"
			PHP_ARGS="$PHP_ARGS $arg"
			;;
		*)
			PHP_ARGS="$PHP_ARGS $arg"
			;;
	esac
done

PHP_ARGS="${PHP_ARGS# }"

if [ "$MODE" = "update" ] && [ -n "$PRESET" ]; then
	echo "mode=update doesn't support preset=. Run without preset." >&2
	exit 1
fi

# shellcheck disable=SC2086
run_seeder() {
	container="$1"
	label="$2"
	args="$3"
	echo "Seeding $label site: $args"
	# --use-include runs the file via include() instead of eval(), which is required
	# for declare(strict_types=1) to be permitted (PHP disallows declare inside eval).
	wp-env run "$container" --env-cwd="wp-content/plugins/$PLUGIN_DIR" wp eval-file --use-include ./bin/seed-content.php $args
}

run_preset_full() {
	container="$1"
	label="$2"
	echo "Running full preset on $label site..."
	# Purge previously seeded content first, if requested.
	if [ -n "$FRESH_ARG" ]; then
		run_seeder "$container" "$label" "purge=1"
	fi
	# Gutenberg posts, all image modes via auto.
	run_seeder "$container" "$label" "count=10 type=post editor=gutenberg images=auto date-offset=90 $PHP_ARGS"
	# Classic posts, all image modes via auto.
	run_seeder "$container" "$label" "count=10 type=post editor=classic images=auto start=11 $PHP_ARGS"
	# Pages with varied images.
	run_seeder "$container" "$label" "count=5 type=page editor=gutenberg images=auto start=21 $PHP_ARGS"
}

execute() {
	container="$1"
	label="$2"
	if [ "$PRESET" = "full" ]; then
		run_preset_full "$container" "$label"
	elif [ -n "$PRESET" ]; then
		echo "Unknown preset '$PRESET'. Available presets: full." >&2
		exit 1
	else
		run_seeder "$container" "$label" "$PHP_ARGS $FRESH_ARG"
	fi
}

case "$SITE" in
	source)
		execute tests-cli source
		;;
	destination)
		execute cli destination
		;;
	both)
		execute tests-cli source
		execute cli destination
		;;
	*)
		echo "Unknown site '$SITE'. Use: site=source (default), site=destination, or site=both." >&2
		exit 1
		;;
esac
