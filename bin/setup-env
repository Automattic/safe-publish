#!/bin/sh

PORT="${WP_ENV_PORT-8888}"
TESTS_PORT="${WP_ENV_TESTS_PORT-8889}"

# Target site (development env / cli / port $PORT)
wp-env run cli wp option update blogname 'Safe Publish Destination'
wp-env run cli wp option update safe_publish_sync_mode 'import'
wp-env run cli wp option update safe_publish_connected_site_url "http://host.docker.internal:$TESTS_PORT"
wp-env run cli wp rewrite structure '/%postname%/'
wp-env run cli wp rewrite flush

# Source site (tests env / tests-cli / port $TESTS_PORT)
wp-env run tests-cli wp option update blogname 'Safe Publish Source'
wp-env run tests-cli wp option update safe_publish_sync_mode 'export'
wp-env run tests-cli wp option update safe_publish_connected_site_url "http://localhost:$PORT"
wp-env run tests-cli wp rewrite structure '/%postname%/'
wp-env run tests-cli wp rewrite flush

# Rewrite any existing source content that still references localhost:8889
# to the canonical cross-container URL. The mu-plugin in
# mu-plugins/safe-publish-local-dev.php keeps home/siteurl pointing at the
# same hostname so freshly uploaded media URLs match. Skip the guid column
# (WP requires GUIDs to be immutable). Safe to re-run; idempotent once the
# rewrite has completed.
wp-env run tests-cli wp search-replace \
	'http://localhost:8889' \
	'http://host.docker.internal:8889' \
	--all-tables \
	--skip-columns=guid \
	--quiet

# Reconcile attachment DB rows with the filesystem. Container recreation
# (config edits, dev:destroy, Docker Desktop updates, host reboot) wipes
# the in-container uploads directory while the DB volume survives,
# leaving attachment posts pointing at files that no longer exist on
# disk. Delete those orphan rows so the DB matches reality. Inline image
# URLs baked into post_content are left broken on purpose — the visible
# breakage is the signal to re-seed (npm run seed:source).
RECONCILE_ORPHANS='
$removed = 0;
foreach ( get_posts( [
	"post_type"      => "attachment",
	"post_status"    => "any",
	"posts_per_page" => -1,
	"fields"         => "ids",
] ) as $id ) {
	$path = get_attached_file( $id );
	if ( $path && ! file_exists( $path ) ) {
		wp_delete_attachment( $id, true );
		$removed++;
	}
}
if ( $removed > 0 ) {
	WP_CLI::log( sprintf( "Removed %d orphan attachment(s).", $removed ) );
}
'
wp-env run cli wp eval "$RECONCILE_ORPHANS"
wp-env run tests-cli wp eval "$RECONCILE_ORPHANS"
