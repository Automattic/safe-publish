#!/bin/sh
#
# Run all PHPUnit integration test suites, forwarding any extra args
# to each suite. Useful for sharing flags like --filter across suites.
#
# Set WP_MULTISITE=1 to install the network and run the suites on multisite.
#
# Usage: bin/test-integration [phpunit args...]

set -e

# wp-env mounts the plugin under wp-content/plugins/<checkout dir name>,
# which differs from the canonical slug in worktrees.
PLUGIN_DIR="$(basename "$(git rev-parse --show-toplevel)")"

for config in \
	phpunit-integration-sync-bidirectional.xml \
	phpunit-integration-sync-import.xml \
	phpunit-integration-sync-export.xml; do
	wp-env run tests-cli \
		--env-cwd="wp-content/plugins/$PLUGIN_DIR" \
		env WP_TESTS_DIR=/wordpress-phpunit \
		WP_MULTISITE="${WP_MULTISITE:-0}" \
		./vendor/bin/phpunit -c "./$config" "$@"
done
