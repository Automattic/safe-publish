#!/bin/sh
#
# Run the Playwright end-to-end suite against this checkout's development
# site, forwarding any extra args to wp-scripts.
#
# Usage: bin/test-e2e [playwright args...]

set -e

cd "$(git rev-parse --show-toplevel)"

# Resolve the target the way bin/start resolves wp-env ports, so a worktree
# runs against its own environment instead of another checkout's. Precedence:
# a pre-set WP_BASE_URL (CI, an external orchestrator), then WP_ENV_PORT, then
# the pair in .devports. The target is the development instance, which
# bin/setup-env puts in import mode and pins to host.docker.internal.
if [ -z "$WP_BASE_URL" ]; then
	if [ -z "$WP_ENV_PORT" ] && [ -f .devports ]; then
		if [ -r .devports ]; then
			. ./.devports
		else
			echo "warning: cannot read .devports; using defaults" >&2
		fi
	fi
	WP_BASE_URL="http://host.docker.internal:${WP_ENV_PORT-8888}"
fi
export WP_BASE_URL

# Fail fast. Without this probe an unreachable site retries for 60 seconds
# before Playwright's global setup surfaces the connection error.
if ! curl -sf -o /dev/null --max-time 30 "$WP_BASE_URL"; then
	echo "Cannot reach $WP_BASE_URL. Run \`npm run dev\` first." >&2
	exit 1
fi

echo "Running end-to-end tests against $WP_BASE_URL"

exec npx wp-scripts test-playwright "$@"
