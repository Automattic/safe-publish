#!/usr/bin/env php
<?php
/**
 * Updates CI matrices from WordPress' published PHP compatibility table.
 *
 * @package Safe_Publish
 */

declare(strict_types=1);

const COMPATIBILITY_URL =
	'https://make.wordpress.org/core/handbook/references/' .
	'php-compatibility-and-wordpress-versions/';
const BEGIN_MARKER      = '# BEGIN GENERATED COMPATIBILITY MATRIX';
const END_MARKER        = '# END GENERATED COMPATIBILITY MATRIX';

$root   = dirname( __DIR__ );
$source = COMPATIBILITY_URL;

foreach ( $argv as $argument ) {
	if ( str_starts_with( $argument, '--source=' ) ) {
		$source = substr( $argument, strlen( '--source=' ) );
	}
}

$minimum_wordpress = read_minimum_wordpress( $root . '/safe-publish.php' );
$minimum_php       = read_minimum_php( $root . '/composer.json' );
$snapshot_path     = $root . '/.github/compatibility-matrix.json';
$published         = read_compatibility_table(
	read_source( $source ),
	$minimum_wordpress,
	$minimum_php
);
$snapshot          = compact_matrix(
	$published,
	$minimum_wordpress,
	$minimum_php
);
$updates           = build_updates( $published, $minimum_php );
$pending           = array();

$encoded_snapshot = encode_snapshot( $snapshot );
$current_snapshot = file_get_contents( $snapshot_path );
if ( $encoded_snapshot !== $current_snapshot ) {
	$pending['.github/compatibility-matrix.json'] = $encoded_snapshot;
}

foreach ( $updates as $relative_path => $generated ) {
	$path     = $root . '/' . $relative_path;
	$original = file_get_contents( $path );
	if ( false === $original ) {
		fail( "Could not read {$relative_path}." );
	}

	$updated = replace_generated_section( $original, $generated, $relative_path );
	if ( $updated === $original ) {
		continue;
	}

	$pending[ $relative_path ] = $updated;
}

foreach ( $pending as $relative_path => $contents ) {
	if ( false === file_put_contents( $root . '/' . $relative_path, $contents ) ) {
		fail( "Could not write {$relative_path}." );
	}
}

if ( array() === $pending ) {
	echo "CI compatibility matrices are current.\n";
	exit( 0 );
}

echo "Updated CI compatibility matrices:\n";
foreach ( array_keys( $pending ) as $relative_path ) {
	echo "- {$relative_path}\n";
}

exit( 0 );

/**
 * Reads the plugin's minimum supported WordPress version.
 */
function read_minimum_wordpress( string $path ): string {
	$contents = file_get_contents( $path );
	if ( false === $contents
		|| 1 !== preg_match( '/Requires at least:\s*(\d+\.\d+)/', $contents, $match )
	) {
		fail( 'Could not read Requires at least from safe-publish.php.' );
	}

	return $match[1];
}

/**
 * Reads the package's minimum supported PHP version.
 */
function read_minimum_php( string $path ): string {
	$contents = file_get_contents( $path );
	$composer = false === $contents ? null : json_decode( $contents, true );
	$require  = is_array( $composer ) ? ( $composer['require']['php'] ?? null ) : null;

	if ( ! is_string( $require )
		|| 1 !== preg_match( '/(\d+\.\d+)/', $require, $match )
	) {
		fail( 'Could not read the PHP requirement from composer.json.' );
	}

	return $match[1];
}

/**
 * Reads a local fixture or remote compatibility page.
 */
function read_source( string $source ): string {
	$context = stream_context_create(
		array(
			'http' => array(
				'header'  => "User-Agent: safe-publish-ci-matrix\r\n",
				'timeout' => 30,
			),
		)
	);
	$html    = @file_get_contents( $source, false, $context );

	if ( false === $html || '' === $html ) {
		fail( "Could not fetch compatibility data from {$source}." );
	}

	return $html;
}

/**
 * Compacts a contiguous compatibility matrix into maxima and exceptions.
 *
 * @param array<string, string[]> $matrix Supported combinations.
 * @return array<string, mixed>
 */
function compact_matrix(
	array $matrix,
	string $minimum_wordpress,
	string $minimum_php
): array {
	$wordpress_versions = array_keys( $matrix );
	$latest_wordpress   = end( $wordpress_versions );
	$all_php            = array();

	if ( $wordpress_versions !== version_range( $minimum_wordpress, $latest_wordpress ) ) {
		fail( 'Supported WordPress versions are not contiguous.' );
	}

	foreach ( $matrix as $wordpress_version => $php_versions ) {
		$maximum_php = end( $php_versions );
		if ( $php_versions !== version_range( $minimum_php, $maximum_php ) ) {
			fail(
				"PHP support for WordPress {$wordpress_version} is not contiguous."
			);
		}
		foreach ( $php_versions as $php_version ) {
			$all_php[ $php_version ] = true;
		}
	}

	$all_php = array_keys( $all_php );
	usort( $all_php, 'version_compare' );
	$latest_php = end( $all_php );
	$overrides  = array();
	foreach ( $matrix as $wordpress_version => $php_versions ) {
		$maximum_php = end( $php_versions );
		if ( $maximum_php !== $latest_php ) {
			$overrides[ $wordpress_version ] = $maximum_php;
		}
	}

	return array(
		'source'              => COMPATIBILITY_URL,
		'latestWordPress'     => $latest_wordpress,
		'latestPhp'           => $latest_php,
		'phpMaximumOverrides' => $overrides,
	);
}

/**
 * Returns every major/minor version in an inclusive range.
 *
 * @return string[]
 */
function version_range( string $minimum, string $maximum ): array {
	if ( version_compare( $minimum, $maximum, '>' ) ) {
		fail( "Invalid version range {$minimum} to {$maximum}." );
	}

	list($major, $minor) = array_map( 'intval', explode( '.', $minimum ) );
	$versions            = array();
	while ( true ) {
		$version    = "{$major}.{$minor}";
		$versions[] = $version;
		if ( $version === $maximum ) {
			return $versions;
		}
		++$minor;
		if ( 10 === $minor ) {
			++$major;
			$minor = 0;
		}
	}
}

/**
 * Encodes the committed snapshot in its canonical format.
 *
 * @param array<string, mixed> $snapshot Cached compatibility data.
 */
function encode_snapshot( array $snapshot ): string {
	$encoded = json_encode(
		$snapshot,
		JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR
	);
	$encoded = preg_replace_callback(
		'/^( +)/m',
		static fn( array $match ): string => str_repeat(
			' ',
			(int) ( strlen( $match[1] ) / 2 )
		),
		$encoded
	);
	if ( null === $encoded ) {
		fail( 'Could not format the compatibility snapshot.' );
	}

	return $encoded . "\n";
}

/**
 * Extracts supported combinations at or above the package's version floors.
 *
 * @return array<string, string[]>
 */
function read_compatibility_table(
	string $html,
	string $minimum_wordpress,
	string $minimum_php
): array {
	$document = new DOMDocument();
	$previous = libxml_use_internal_errors( true );
	$loaded   = $document->loadHTML( $html );
	libxml_clear_errors();
	libxml_use_internal_errors( $previous );

	if ( ! $loaded ) {
		fail( 'WordPress returned invalid compatibility HTML.' );
	}

	$xpath = new DOMXPath( $document );
	$table = find_supported_table( $xpath );
	$rows  = $xpath->query( './/tr', $table );
	if ( false === $rows || 2 > $rows->length ) {
		fail( 'The supported compatibility table has no data rows.' );
	}

	$headers      = row_values( $xpath, $rows->item( 0 ) );
	$php_columns  = array();
	$combinations = array();

	foreach ( $headers as $index => $header ) {
		if ( 0 < $index && is_version( $header )
			&& version_compare( $header, $minimum_php, '>=' )
		) {
			$php_columns[ $index ] = $header;
		}
	}

	if ( ! in_array( $minimum_php, $php_columns, true ) ) {
		fail( "PHP {$minimum_php} is missing from WordPress' supported table." );
	}

	for ( $row_index = 1; $row_index < $rows->length; $row_index++ ) {
		$values            = row_values( $xpath, $rows->item( $row_index ) );
		$wordpress_version = $values[0] ?? '';
		if ( ! is_version( $wordpress_version )
			|| version_compare( $wordpress_version, $minimum_wordpress, '<' )
		) {
			continue;
		}

		if ( isset( $combinations[ $wordpress_version ] ) ) {
			fail( "Duplicate WordPress {$wordpress_version} compatibility row." );
		}

		$supported = array();
		foreach ( $php_columns as $index => $php_version ) {
			$value = $values[ $index ] ?? '';
			if ( ! in_array( $value, array( 'Y', 'N' ), true ) ) {
				fail(
					"Unexpected {$value} value for WordPress " .
					"{$wordpress_version} and PHP {$php_version}."
				);
			}
			if ( 'Y' === $value ) {
				$supported[] = $php_version;
			}
		}

		if ( array() === $supported ) {
			fail( "WordPress {$wordpress_version} has no supported PHP versions." );
		}
		usort( $supported, 'version_compare' );
		$combinations[ $wordpress_version ] = $supported;
	}

	if ( ! isset( $combinations[ $minimum_wordpress ] ) ) {
		fail( "WordPress {$minimum_wordpress} is missing from the supported table." );
	}

	uksort( $combinations, 'version_compare' );
	return $combinations;
}

/**
 * Finds the first table identified as the supported compatibility table.
 */
function find_supported_table( DOMXPath $xpath ): DOMElement {
	$tables = $xpath->query( '//table' );
	if ( false === $tables ) {
		fail( 'Could not inspect WordPress compatibility tables.' );
	}

	foreach ( $tables as $table ) {
		if ( ! ( $table instanceof DOMElement ) ) {
			continue;
		}
		$first_row = $xpath->query( './/tr[1]', $table )?->item( 0 );
		$values    = row_values( $xpath, $first_row );
		if ( 'WP / PHP Version' === ( $values[0] ?? '' ) ) {
			return $table;
		}
	}

	fail( 'Could not find WordPress\' supported PHP compatibility table.' );
}

/**
 * Reads normalized text from a table row.
 *
 * @return string[]
 */
function row_values( DOMXPath $xpath, ?DOMNode $row ): array {
	if ( null === $row ) {
		return array();
	}

	$cells = $xpath->query( './th|./td', $row );
	if ( false === $cells ) {
		return array();
	}

	$values = array();
	foreach ( $cells as $cell ) {
		$value    = preg_replace( '/\s+/', ' ', trim( $cell->textContent ) );
		$values[] = null === $value ? '' : $value;
	}

	return $values;
}

/**
 * Determines whether a table label is a major/minor version.
 */
function is_version( string $value ): bool {
	return 1 === preg_match( '/^\d+\.\d+$/', $value );
}

/**
 * Builds the generated contents for every compatibility-aware workflow.
 *
 * @param array<string, string[]> $matrix Supported combinations.
 * @return array<string, string>
 */
function build_updates( array $matrix, string $minimum_php ): array {
	$integration  = "        include:\n";
	$e2e          = "        include:\n";
	$php_versions = array();

	foreach ( $matrix as $wordpress_version => $supported_php ) {
		foreach ( $supported_php as $php_version ) {
			$integration                 .=
				"          - wordpress-version: '{$wordpress_version}'\n" .
				"            php-version: '{$php_version}'\n";
			$php_versions[ $php_version ] = true;
		}

		$e2e_php = end( $supported_php );
		$e2e    .=
			"          - wordpress-version: '{$wordpress_version}'\n" .
			'            wordpress-ref: ' .
			"WordPress/WordPress#{$wordpress_version}-branch\n" .
			"            php-version: '{$e2e_php}'\n";
	}

	$php_versions = array_keys( $php_versions );
	usort( $php_versions, 'version_compare' );
	$quoted_php  = array_map(
		static fn( string $version ): string => "'{$version}'",
		$php_versions
	);
	$maximum_php = end( $php_versions );

	return array(
		'.github/workflows/integration-tests.yml'     => $integration,
		'.github/workflows/e2e-tests.yml'             => $e2e,
		'.github/workflows/unit-tests.yml'            =>
			'        php-version: [' . implode( ', ', $quoted_php ) . "]\n",
		'.github/workflows/static-checks.yml'         =>
			"          php-version: '{$minimum_php}'\n",
		'.github/workflows/wordpress-trunk-tests.yml' =>
			"      php-version: '{$maximum_php}'\n",
	);
}

/**
 * Replaces the contents between the generated section markers.
 */
function replace_generated_section(
	string $workflow,
	string $generated,
	string $relative_path
): string {
	$begin = strpos( $workflow, BEGIN_MARKER );
	$end   = strpos( $workflow, END_MARKER );
	if ( false === $begin || false === $end || $end <= $begin ) {
		fail( "Missing generated matrix markers in {$relative_path}." );
	}
	if ( false !== strpos( $workflow, BEGIN_MARKER, $begin + 1 )
		|| false !== strpos( $workflow, END_MARKER, $end + 1 )
	) {
		fail( "Duplicate generated matrix markers in {$relative_path}." );
	}

	$content_start = strpos( $workflow, "\n", $begin );
	if ( false === $content_start ) {
		fail( "Invalid generated matrix markers in {$relative_path}." );
	}
	$end_line_start = strrpos( substr( $workflow, 0, $end ), "\n" );
	if ( false === $end_line_start ) {
		fail( "Invalid generated matrix markers in {$relative_path}." );
	}

	return substr( $workflow, 0, $content_start + 1 ) .
		$generated . substr( $workflow, $end_line_start + 1 );
}

/**
 * Writes an error to STDERR and exits unsuccessfully.
 *
 * @return never
 */
function fail( string $message ): never {
	fwrite( STDERR, "Error: {$message}\n" );
	exit( 1 );
}
