.wp-env.override.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage

# Build output (only at root)
/build/

# Dependency directories
/node_modules/
/vendor/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Tests
.phpunit.cache/
.phpunit.result.cache
/artifacts/

# Output of `npm run plugin-zip`
*.zip

# Editors
.idea/*
!.idea/runConfigurations/
.vscode/*
!.vscode/*.example
.zed

# Claude Code
.claude/*
!.claude/settings.json

# Playwright MCP scratch output
/.playwright-mcp/

# Local design / scratch notes — kept out of the repo by convention.
/*.diff
/PATCH_*.md
/RECOMMENDED_*
/ROUTE_EXTRACTION_*
/SECURITY_*.md
/SIMPLE_ROUTE_*.md
/WP_METHOD_ROUTE_*.md
/rest-route-*.php
/scratch/
/.scratch/
