.wp-env.override.json
.devports

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage

# Build output (only at root)
/build/

# Dependency directories
/node_modules/
/vendor/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Tests
.phpunit.cache/
.phpunit.result.cache
/artifacts/

# Output of `npm run plugin-zip`
*.zip

# Editors
.idea/*
!.idea/runConfigurations/
.vscode/*
!.vscode/*.example
.zed

# Claude Code
.claude/*
!.claude/settings.json

# Playwright MCP scratch output
/.playwright-mcp/

# Ad-hoc diff files and the scratch directory at repo root. The linters and
# vitest carry matching ignore lists; grep for .scratch to keep them in step.
/*.diff
/.scratch/
